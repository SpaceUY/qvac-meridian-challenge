# Example identities from the README - fine for local testing only.
# For anything real, generate fresh ones: npm run seed:generate --workspace=apps/backend
# (run it once per process; never give the provider and server the same seed).

# Provider identity: seed + the public key derived from it.
PROVIDER_SEED=46d223b4e0abef080208b21722001e8dff6c2cc370ac7c07579f31309c9db328
PROVIDER_PUBLIC_KEY=3640fa359b64de0dc045c3aba7f5757b5a4e4174e4405f976ac0b3156330ca9f

# Server (consumer) identity: the provider's firewall only allows this public key.
SERVER_SEED=dabbbea7187e11fdac92b41aa6569db22adc882c6fd5d2ff6b62d492e8ba506c
SERVER_PUBLIC_KEY=7a1a5772e5516de097517ece9d8c3c83087db516842b5fa4dd2fa125c583c18e

# Optional: how long the server waits on a delegated model load before falling back to local.
# DELEGATE_TIMEOUT_MS=60000
