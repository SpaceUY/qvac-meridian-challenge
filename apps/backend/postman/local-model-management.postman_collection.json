              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const baseUrl = pm.collectionVariables.get('baseUrl');",
                  "const requestId = pm.collectionVariables.get('requestId');",
                  "let status = pm.response.json();",
                  "",
                  "for (let attempt = 0; attempt < 60 && status.state === 'pending'; attempt++) {",
                  "  await new Promise((resolve) => setTimeout(resolve, 1000));",
                  "  const res = await pm.sendRequest({ url: `${baseUrl}/api/models/requests/${requestId}`, method: 'GET' });",
                  "  status = res.json();",
                  "}",
                  "",
                  "pm.test('Inference settled (not still pending)', () => pm.expect(status.state).to.not.eql('pending'));",
                  "if (status.state === 'cancelled') {",
                  "  pm.test('Inference was cancelled', () => pm.expect(status.state).to.eql('cancelled'));",
                  "} else {",
                  "  console.warn('Inference finished before the cancel took effect (fast model/short response) - state:', status.state, '- this is the same best-effort race the SDK documents for cancel(), not a bug.');",
