          "name": "GET /api/models/requests/{{requestId}} (poll until settled, expect cancelled)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/models/requests/{{requestId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "models", "requests", "{{requestId}}"]
            }
          },
          "event": [
