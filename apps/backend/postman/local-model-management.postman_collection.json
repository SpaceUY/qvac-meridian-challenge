            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Fires right after 'start' captured requestId, before the load has had time to",
                  "// settle - this only demonstrates a real in-flight cancel because /load returned",
                  "// before completion (202 + requestId). Best-effort like the underlying SDK cancel():",
                  "// on an unusually fast/cached load this could still land after it finished, in which",
                  "// case the next poll request will report 'succeeded' instead and log a note.",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('ok:true', () => pm.response.json().ok === true);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/models/requests/{{requestId}} (poll until settled, expect cancelled)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/models/requests/{{requestId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "models", "requests", "{{requestId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const baseUrl = pm.collectionVariables.get('baseUrl');",
                  "const requestId = pm.collectionVariables.get('requestId');",
                  "let status = pm.response.json();",
                  "",
                  "for (let attempt = 0; attempt < 60 && status.state === 'pending'; attempt++) {",
                  "  await new Promise((resolve) => setTimeout(resolve, 1000));",
                  "  const res = await pm.sendRequest({ url: `${baseUrl}/api/models/requests/${requestId}`, method: 'GET' });",
                  "  status = res.json();",
                  "}",
                  "",
                  "pm.test('Load settled (not still pending)', () => pm.expect(status.state).to.not.eql('pending'));",
                  "if (status.state === 'cancelled') {",
                  "  pm.test('Load was cancelled', () => pm.expect(status.state).to.eql('cancelled'));",
                  "} else {",
                  "  console.warn('Load finished before the cancel took effect (fast/cached model) - state:', status.state, '- this is the same best-effort race the SDK documents for cancel(), not a bug.');",
                  "}"
                ]
              }
            }
          ]
