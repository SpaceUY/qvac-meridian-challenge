    {
      "name": "3. Load (should reuse the provisioned cache, not re-download)",
      "item": [
        {
          "name": "POST /api/models/load (start, registry source)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": {\n    \"kind\": \"registry\",\n    \"registryPath\": \"{{registryPath}}\",\n    \"registrySource\": \"{{registrySource}}\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/models/load", "host": ["{{baseUrl}}"], "path": ["api", "models", "load"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 202', () => pm.response.to.have.status(202));",
                  "const json = pm.response.json();",
                  "pm.test('Has requestId', () => typeof json.requestId === 'string' && json.requestId.length > 0);",
                  "if (json.requestId) {",
                  "  pm.collectionVariables.set('requestId', json.requestId);",
                  "  console.log('requestId ->', json.requestId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/models/requests/{{requestId}} (poll until settled)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/models/requests/{{requestId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "models", "requests", "{{requestId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const baseUrl = pm.collectionVariables.get('baseUrl');",
                  "const requestId = pm.collectionVariables.get('requestId');",
                  "let status = pm.response.json();",
                  "",
                  "for (let attempt = 0; attempt < 60 && status.state === 'pending'; attempt++) {",
                  "  await new Promise((resolve) => setTimeout(resolve, 1000));",
                  "  const res = await pm.sendRequest({ url: `${baseUrl}/api/models/requests/${requestId}`, method: 'GET' });",
                  "  status = res.json();",
                  "}",
                  "",
                  "pm.test('Load settled (not still pending)', () => pm.expect(status.state).to.not.eql('pending'));",
                  "pm.test('Load succeeded', () => pm.expect(status.state).to.eql('succeeded'));",
                  "pm.test('Has modelId', () => typeof status.modelId === 'string' && status.modelId.length > 0);",
                  "if (status.modelId) {",
                  "  pm.collectionVariables.set('modelId', status.modelId);",
                  "  console.log('modelId ->', status.modelId);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
